        {
          "name": "01 · Registro de usuario nuevo",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('userEmail', 'user_' + Date.now() + '@mail.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const u = pm.response.json().payload;",
                  "pm.test('role forzado a user (ignora el role del body)', () => pm.expect(u.role).to.eql('user'));",
                  "pm.test('La respuesta no contiene password', () => pm.expect(pm.response.text()).to.not.include('password'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
