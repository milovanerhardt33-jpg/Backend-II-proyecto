PORT=8080
NODE_ENV=development
MONGO_URL=
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Nodemailer (emails de confirmación y cancelación de inscripción)
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Solo para `npm run seed` (usuarios de prueba). Elegí una contraseña propia;
# no se usa en producción ni en ningún otro punto de la app.
SEED_PASSWORD=

# Opcional: solo si al conectar a Atlas aparece "querySrv ECONNREFUSED".
# Fuerza los servidores DNS que usa Node (ej: 8.8.8.8,1.1.1.1). Si anda, dejalo vacío.
DNS_SERVERS=
